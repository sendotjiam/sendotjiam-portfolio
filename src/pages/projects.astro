---
import Header from '../components/Header.astro';
import Project from '../components/Project.astro';
import Sidebar from '../components/Sidebar.astro';
import { BASE_URL, getAssetPath } from '../config/constants';
const projects = [
  {
    title: "Grab Driver",
    desc: [
      "The primary tool for driver-partners across Southeast Asia to manage bookings and earnings. Contributed to the In Transit flow, enhancing the experience and reliability from job acceptance through to completion, ensuring a seamless journey for both drivers and passengers."
    ],
    tech: ["Swift", "UIKit", "RxSwift", "VIPER", "Unit Testing", "UI Testing", "Modularization", "TCP"],
    logo: "/assets/company-logo/grab-logo.jpeg",
    appStoreLink: "https://apps.apple.com/us/app/grab-driver-app-for-partners/id1257641454"
  },
  {
    title: "WikiBus",
    desc: [
      "A comprehensive bus app for Singapore's public transportation system. Provides real-time bus arrival times, route information, and bus stop details to help commuters navigate Singapore's extensive bus network efficiently."
    ],
    tech: ["iOS", "UIKit", "Coordinator Pattern", "Model View ViewModel", "Combine", "Modularization"],
    logo: "/assets/project-logo/wikibus-logo.png",
    appStoreLink: "https://id.linkedin.com/posts/sendo-tjiamis-a03a73192_wiki-bus-activity-7071854626613952512-VNfx"
  },
  {
    title: "Tokopedia",
    desc: [
      "Indonesia's leading e-commerce platform offering a comprehensive marketplace experience with features like free shipping, daily promos, and secure payment options. The app serves millions of users with product discovery, seller tools, and integrated payment solutions."
    ],
    tech: ["Swift", "UIKit", "Texture (AsyncDisplayKit)", "RxSwift", "Combine", "The Composable Architecture (TCA)", "Model View ViewModel", "Unit Testing", "Modularization", "REST API", "GraphQL"],
    logo: "/assets/project-logo/tokopedia-logo.jpeg",
    appStoreLink: "https://apps.apple.com/id/app/tokopedia/id1001394201"
  },
  {
    title: "EduAI",
    desc: [
      "An on-demand AI tutor and life coach that creates personalized learning paths for lifelong education, focusing on Singapore primary level English, EduAI adapts learning to fit each student rather than forcing students to fit a rigid curriculum."
    ],
    tech: ["React", "Node.js", "MongoDB", "OpenAI API"],
    logo: "/assets/project-logo/eduai-logo.jpeg",
    appStoreLink: "https://www.eduai.biz/"
  },
  {
    title: "BuyMax",
    desc: [
      "A cryptocurrency price viewer application with real-time market data and trading information. Displays live cryptocurrency prices and market updates for informed trading decisions."
    ],
    tech: ["Swift", "iOS", "Model View ViewModel", "WebSocket"],
    logo: "/assets/code.svg",
    appStoreLink: "https://github.com/sendotjiam/buymax-ios"
  },
  {
    title: "OVO",
    desc: [
      "Indonesia's leading all-in-one fintech app for payments, savings, and lifestyle services. Features include cashless payments, bill payments, money transfers, cashback rewards, and integrated merchant ecosystem serving millions of users across Indonesia."
    ],
    tech: ["Swift", "UIKit", "ReactiveKit", "Model View ViewModel", "Unit Testing", "REST API", "Firebase"],
    logo: "/assets/project-logo/ovo-logo.jpeg",
    appStoreLink: "https://apps.apple.com/id/app/ovo/id1047926101"
  },
  {
    title: "MotionBank",
    desc: [
      "Digital banking application by MNC Bank offering comprehensive financial services including easy account opening, virtual credit card, QRIS payments, time deposits, bill payments, and modern banking solutions for Indonesian customers."
    ],
    tech: ["Swift", "UIKit (Xib)", "RxSwift", "Model View ViewModel", "REST API", "Firebase"],
    logo: "/assets/company-logo/mnc-bank-logo.jpeg",
    appStoreLink: "https://apps.apple.com/us/app/motionbank/id1506555741"
  },
  {
    title: "KlikDiabetes",
    desc: [
      "Comprehensive diabetes management application providing health record tracking, personalized diet and nutrition guidance, medication reminders, and educational resources to help users effectively manage their diabetes therapy and maintain healthy lifestyles."
    ],
    tech: ["Swift", "UIKit (Xib)", "Delegate", "Model View Controller", "REST API"],
    logo: "/assets/project-logo/klikdiabetes-logo.png",
    appStoreLink: "https://apps.apple.com/id/app/klik-diabetes/id1541593080"
  }
];
---

<!DOCTYPE html>
<html>
  <Header title="Projects | Sendo Tjiamis" />
  <body>
    <div class="content">
        <Sidebar selectedItem="projects" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href={BASE_URL} class="back-nav-button w-inline-block"
              ><img src={getAssetPath('/assets/back.svg')} loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1 style="font-weight: bold;">Projects</h1>
            <section class="items-container">
                <!-- iOS App Development Skills -->
                <div class="projects-container" style="cursor: default; text-decoration: none; margin-bottom: 48px;">
                  <div class="single-projects-content">
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <div style="background-color: white; border-radius: 6px; padding: 4px;">
                        <img src={getAssetPath('/assets/apple-logo.png')} alt="Apple iOS" style="width: 32px; height: 32px;" />
                      </div>
                      <h4 style="font-weight: bold; margin: 0;">iOS Development Skills</h4>
                    </div>
                    <div class="tech-tools-container">
                      <div class="mini-label-white gray-color">Frameworks &amp; Technologies</div>
                      <div class="chips-container chips-container-large-width">
                        <div class="single-chip small-chip">Swift</div>
                        <div class="single-chip small-chip">SwiftUI</div>
                        <div class="single-chip small-chip">UIKit</div>
                        <div class="single-chip small-chip">Texture (AsyncDisplayKit)</div>
                        <div class="single-chip small-chip">Model View View Model (MVVM)</div>
                        <div class="single-chip small-chip">The Composable Architecture (TCA)</div>
                        <div class="single-chip small-chip">Reactive Programming (RxSwift/Combine)</div>
                        <div class="single-chip small-chip">Unit Testing</div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Technical Skills -->
                <div class="projects-container" style="cursor: default; text-decoration: none; margin-bottom: 64px;">
                  <div class="single-projects-content">
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <div style="background-color: #202020; border-radius: 6px; padding: 4px;">
                        <img src={getAssetPath('/assets/code.svg')} alt="Skills" style="width: 32px; height: 32px;" />
                      </div>
                      <h4 style="font-weight: bold; margin: 0;">Technical Skills</h4>
                    </div>
                    <div class="tech-tools-container">
                      <div class="mini-label-white gray-color">Languages</div>
                      <div class="chips-container chips-container-large-width">
                        <div class="single-chip small-chip">Dart</div>
                        <div class="single-chip small-chip">Java</div>
                        <div class="single-chip small-chip">Python</div>
                        <div class="single-chip small-chip">HTML</div>
                        <div class="single-chip small-chip">CSS</div>
                        <div class="single-chip small-chip">Javascript</div>
                        <div class="single-chip small-chip">PHP</div>
                      </div>
                    </div>
                    <div class="tech-tools-container">
                      <div class="mini-label-white gray-color">Other Frameworks &amp; Technologies</div>
                      <div class="chips-container chips-container-small-width">
                        <div class="single-chip small-chip">Flutter</div>
                        <div class="single-chip small-chip">Web Development (HTML, CSS, Javascript)</div>
                        <div class="single-chip small-chip">Backend Development (Node.js, Laravel)</div>
                      </div>
                    </div>
                  </div>
                </div>

                <h2 style="font-weight: bold; margin-bottom: 32px;">Featured Projects</h2>
                <div class="resouce-items">
                    {projects.map(project => (
                      <Project 
                        title={project.title} 
                        desc={project.desc}
                        tech={project.tech}
                        logo={getAssetPath(project.logo)}
                        appStoreLink={project.appStoreLink}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
    
    <!-- Analytics Initialization -->
    <script>
      import { initAnalytics } from '../scripts/analytics-init.js';
      
      // Initialize analytics when page loads
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAnalytics);
      } else {
        initAnalytics();
      }
    </script>
  </body>
</html>