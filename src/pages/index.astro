---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
---


<!DOCTYPE html>
<html>
  <Header title="Sendo Tjiamis" />
  <body>
    <div class="content">
      <Sidebar selectedItem="home" />
      <nav class="main">
        <div class="container">
          <main class="fold-content-container">
            <div class="fold-content">
              <h1 style="font-weight: bold;">Hi, I'm <strong>Sendo</strong> 👋🏻<br />I build apps for <strong>iOS</strong>.</h1>
              <p class="lead">
                Experienced <strong>iOS developer</strong> specializing in <strong>Swift</strong> and <strong>mobile app development</strong>. A proactive team member dedicated to continuous learning, problem-solving, and creating exceptional user experiences on <strong>Apple platforms</strong>.
              </p>
            </div>
            <div style="display: flex; gap: 16px; align-items: center;">
              <a href="mailto:sendotjiamis9898@gmail.com" class="button w-button">Contact</a>
              <a 
                href="https://www.linkedin.com/in/sendo-tjiamis-a03a73192" 
                target="_blank" 
                rel="noopener noreferrer"
                style="
                  display: inline-flex;
                  align-items: center;
                  gap: 8px;
                  padding: 12px 24px;
                  background: linear-gradient(135deg, #0077B5 0%, #005885 100%);
                  color: white;
                  text-decoration: none;
                  border-radius: 8px;
                  font-weight: 600;
                  transition: all 0.2s ease;
                  box-shadow: 0 2px 4px rgba(0, 119, 181, 0.2);
                "
                onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 4px 8px rgba(0, 119, 181, 0.3)'"
                onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 4px rgba(0, 119, 181, 0.2)'"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
            </div>
          </main>
          <div class="projects-section">
            <!-- iOS App Development -->
            <a href={`${import.meta.env.BASE_URL}work-experiences`} class="projects-container">
              <div class="single-projects-content">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <div style="background-color: white; border-radius: 6px; padding: 4px;">
                    <img src={`${import.meta.env.BASE_URL}assets/apple-logo.png`} alt="Apple iOS" style="width: 32px; height: 32px;" />
                  </div>
                  <h4 style="font-weight: bold; margin: 0;">iOS Development</h4>
                </div>
                <div class="tech-tools-container">
                  <div class="mini-label-white gray-color">Frameworks &amp; Technologies</div>
                  <div class="chips-container chips-container-large-width">
                    <div class="single-chip small-chip">Swift</div>
                    <div class="single-chip small-chip">SwiftUI</div>
                    <div class="single-chip small-chip">UIKit</div>
                    <div class="single-chip small-chip">Texture (AsyncDisplayKit)</div>
                    <div class="single-chip small-chip">Model View View Model (MVVM)</div>
                    <div class="single-chip small-chip">The Composable Architecture (TCA)</div>
                    <div class="single-chip small-chip">Reactive Programming (RxSwift/Combine)</div>
                    <div class="single-chip small-chip">Unit Testing</div>
                  </div>
                </div>
              </div>
            </a>
            <br>
            <!-- Projects Development -->
            <a href={`${import.meta.env.BASE_URL}projects`} class="projects-container">
              <div class="single-projects-content">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <div style="background-color: #202020; border-radius: 6px; padding: 4px;">
                    <img src={`${import.meta.env.BASE_URL}assets/code.svg`} alt="Projects" style="width: 32px; height: 32px;" />
                  </div>
                  <h4 style="font-weight: bold; margin: 0;">Personal Projects</h4>
                </div>
                <div class="tech-tools-container">
                  <div class="mini-label-white gray-color">Languages</div>
                  <div class="chips-container chips-container-large-width">
                    <div class="single-chip small-chip">Dart</div>
                    <div class="single-chip small-chip">Java</div>
                    <div class="single-chip small-chip">Python</div>
                    <div class="single-chip small-chip">HTML</div>
                    <div class="single-chip small-chip">CSS</div>
                    <div class="single-chip small-chip">Javascript</div>
                    <div class="single-chip small-chip">PHP</div>
                  </div>
                </div>
                <div class="tech-tools-container">
                  <div class="mini-label-white gray-color">Frameworks &amp; Technologies</div>
                  <div class="chips-container chips-container-small-width">
                    <div class="single-chip small-chip">Flutter</div>
                    <div class="single-chip small-chip">Web Development (HTML, CSS, Javascript)</div>
                    <div class="single-chip small-chip">Backend Development (Node.js, Laravel)</div>
                  </div>
                </div>
              </div>
            </a>

          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>