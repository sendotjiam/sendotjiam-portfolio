---
import Header from "../components/Header.astro";
import Project from "../components/Project.astro";
import Sidebar from "../components/Sidebar.astro";
const experiences = [
  {
    jobTitle: "iOS Engineer",
    company: "ByteDance (Tokopedia)",
    logo: "/assets/company-logo/bytedance-logo.jpeg",
    date: "Oct 2023 - Present",
    desc: [
      "Developed the TikTok Seller Center iOS app, enabling account binding and fast onboarding — a key step in migrating sellers from Tokopedia Seller Center to TikTok Seller Center.",
      "Built a reusable TikTok Buyer & Seller Binding service by integrating the TikTok Open Auth SDK — laying the foundation for Tokopedia and TikTok Shop integration.",
      "Optimized login and registration flows by unifying them into a seamless experience, simplifying user onboarding.",
      "Revamped the Tokopedia Account page using Server-Driven UI, allowing fully dynamic components rendered based on server configuration for faster iteration and testing.",
      "Implemented mandatory KYC flow for new sellers using the GoTO Group KYC SDK, improving overall seller quality and compliance.",
      "Developed and integrated User shopping preference and personalization features to surface more relevant items on the Tokopedia homepage, enhancing user engagement.",
      "Contributed to core projects that focus on conducting research on new frameworks to determine their potential for improving app performance, revamp and migrate global components from Texture to UIKit."
    ],
    tech: ["Swift", "UIKit", "Texture (AsyncDisplayKit)", "RxSwift", "Combine", "The Composable Architecture (TCA)", "Model View ViewModel", "Unit Testing", "Modularization", "REST API", "GraphQL"],
    appStoreLink: "https://apps.apple.com/id/app/tokopedia/id1001394201"
  },
  {
    jobTitle: "iOS Engineer Intern",
    company: "Grab (OVO)",
    logo: "/assets/company-logo/grab-logo.jpeg",
    date: "Sep 2022 - May 2023",
    desc: [
      "Developed and delivered payment features on time while collaborating with stakeholders across divisions",
      "Increased internal team productivity by creating technical documentation for OVO App payment features.",
      "Fixed bugs and enhanced functionality of OVO App, demonstrating strong problem-solving skills.",
      "Conducted code reviews for other team members' merge requests, ensuring adherence to best practices and code quality.",
      "Helped and developed some Infra team's tasks, such as adding force update mechanism, feature flag, etc."
    ],
    tech: ["Swift", "UIKit", "ReactiveKit", "Model View ViewModel", "Unit Testing", "REST API", "Firebase"],
    appStoreLink: "https://apps.apple.com/id/app/ovo/id1142114207"
  },
  {
    jobTitle: "iOS Engineer Intern",
    company: "PT. Bank MNC International Tbk.",
    logo: "/assets/company-logo/mnc-bank-logo.jpeg",
    date: "Feb 2022 - Aug 2022",
    desc: [
      "Conducted research and successfully integrated Firebase Analytics into a basic transfer simulation application.",
      "Explored and incorporated Realtime Database functionality into a basic chat application.",
      "Completed development of Motion Banking App features on schedule, working closely with stakeholders from various departments."
    ],
    tech: ["Swift", "UIKit (Xib)", "RxSwift", "Model View ViewModel", "REST API", "Firebase"],
    appStoreLink: "https://apps.apple.com/id/app/motionbank/id1506555741"
  },
  {
    jobTitle: "iOS Engineer Intern",
    company: "PT. Karsa Lintas Buwana (Kalbe E-Health)",
    logo: "/assets/company-logo/kalbe-logo.jpeg",
    date: "Aug 2021 - Feb 2022",
    desc: [
      "Contributed to the migration of the KlikDiabetes application from a hybrid framework to a native framework, utilizing the capabilities of the iOS SDK.",
      "Participated in the development of the KlikDiabetes application, utilizing the iOS SDK to enhance its functionality in the native framework."
    ],
    tech: ["Swift", "UIKit (Xib)", "Delegate", "Model View Controller", "REST API"],
    appStoreLink: "https://apps.apple.com/id/app/klik-diabetes/id1541593080"
  }
];
---

<!DOCTYPE html>
<html>
  <Header title="Work Experiences | Sendo Tjiamis" />
  <body>
    <div class="content">
        <Sidebar selectedItem="work-experiences" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href={import.meta.env.BASE_URL} class="back-nav-button w-inline-block"
              ><img src={`${import.meta.env.BASE_URL}assets/back.svg`} loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1 style="font-weight: bold;">Work Experiences</h1>
            <!-- <p style="color: #6b7280; margin-bottom: 2rem;">My professional journey in iOS development</p> -->
            <section class="timeline-container">
                <div class="timeline-wrapper">
                    {experiences.map((experience, index) => (
                      <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                          <div class="timeline-date">{experience.date}</div>
                          <Project 
                            jobTitle={experience.jobTitle}
                            company={experience.company}
                            desc={experience.desc}
                            tech={experience.tech}
                            logo={experience.logo}
                            appStoreLink={experience.appStoreLink}
                          />
                        </div>
                      </div>
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>

<style>
  .content-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .timeline-container {
    margin-top: 2rem;
  }

  .timeline-wrapper {
    position: relative;
    padding-left: 0;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    padding-left: 3rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 20px;
    bottom: -3rem;
    width: 2px;
    background: #e5e7eb;
    z-index: 1;
  }

  .timeline-item:last-child::before {
    display: none;
  }

  .timeline-dot {
    position: absolute;
    left: 8px;
    top: 12px;
    width: 16px;
    height: 16px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  .timeline-content {
    flex: 1;
    min-width: 0;
  }

  .timeline-date {
    font-size: 0.875rem;
    font-weight: 600;
    color: #667eea;
    margin-bottom: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: rgba(102, 126, 234, 0.1);
    border-radius: 12px;
    display: inline-block;
    border: 1px solid rgba(102, 126, 234, 0.2);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .timeline-item {
      padding-left: 2rem;
      margin-bottom: 2rem;
    }
    
    .timeline-item::before {
      left: 10px;
    }
    
    .timeline-dot {
      left: 4px;
      width: 12px;
      height: 12px;
    }
  }
</style>