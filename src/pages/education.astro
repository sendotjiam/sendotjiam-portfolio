---
import Header from '../components/Header.astro';
import Project from "../components/Project.astro";
import Sidebar from "../components/Sidebar.astro";
import { BASE_URL, getAssetPath } from '../config/constants';
const education = [
  {
    title: "Bachelor of Computer Science",
    university: "Bina Nusantara University (BINUS)",
    date: "Aug 2019 - Mar 2023",
    logo: "/assets/edu-logo/binus-logo.jpeg",
    desc: [
      "Specialized in Mobile Application Development and Software Engineering",
      "Learned Mobile App Development (Android and iOS), Data Structures, Algorithms, Software Design Patterns, etc.",
      "GPA: 3.77 of 4.00"
    ],
    tech: ["Computer Science", "Android Development", "iOS Development", "Software Engineering", "Algorithms", "Data Structures"]
  },
  {
    title: "iOS Engineering Bootcamp",
    university: "BCA - SYNRGY x Binar Academy",
    date: "Mar 2022 - Jul 2022",
    logo: "/assets/edu-logo/synrgy-logo.jpeg",
    desc: [
      "Gained fundamental knowledge in iOS development.",
      "Contributed to the final project as an iOS Engineer on the Homepoint team.",
      "Led the iOS engineering efforts for Sprint 1.",
      "Developed an e-commerce app for furniture sales, implementing UIKit, Clean MVVM Architecture, and RxSwift. Integrated Alamofire for network requests and wrote unit tests with XCTest to ensure reliability"
    ],
    tech: ["Swift", "UIKit", "Clean Architecture", "Model View ViewModel", "RxSwift", "Alamofire", "Unit Testing"],
    projectLink: "https://github.com/sendotjiam/homepoint"
  },
  {
    title: "Fullstack Web Developer Bootcamp",
    university: "BCA - SYNRGY x Binar Academy",
    date: "Jan 2022 - Mar 2022",
    logo: "/assets/edu-logo/synrgy-logo.jpeg",
    desc: [
      "Gained prociency in full-stack development, covering HTML, CSS, JavaScript, and Node.js.",
      "Contributed to the final project as a backend developer on Team Sakara.",
      "Developed the final project using Node.js, Heroku, and Gitlab as the tech stack."
    ],
    tech: ["HTML", "CSS", "Javascript", "Node.js", "Heroku"],
    projectLink: "https://github.com/sendotjiam/sakara-backend"
  }
];
---

<!DOCTYPE html>
<html>
  <Header title="Education | Sendo Tjiamis" />
  <body>
    <div class="content">
        <Sidebar selectedItem="education" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href={BASE_URL} class="back-nav-button w-inline-block"
              ><img src={getAssetPath('/assets/back.svg')} loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1 style="font-weight: bold;">Education</h1>
            <section class="items-container">
                <div class="resouce-items">
                    {education.map(item => (
                      <Project 
                        jobTitle={item.title}
                        company={`${item.university} • ${item.date}`}
                        desc={item.desc}
                        tech={item.tech}
                        logo={getAssetPath(item.logo)}
                        projectLink={item.projectLink}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>