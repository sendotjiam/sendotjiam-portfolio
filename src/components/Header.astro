---
import { ViewTransitions } from 'astro:transitions';
import { getAssetPath, GA4_MEASUREMENT_ID } from '../config/constants';
interface HeaderProps {
  title: string;
}
const { title } = Astro.props as HeaderProps;

// Environment-based configuration
const isDevelopment = import.meta.env.DEV;
const isProduction = import.meta.env.PROD;
---

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>{title}</title>
  <ViewTransitions />
  <meta content={title} property="og:title" />
  <meta content={title} property="twitter:title" />
  <meta content="width=device-width, initial-scale=1" name="viewport" />
  <link href={getAssetPath('/assets/styles.css')} rel="stylesheet" type="text/css" />
  <link href="https://fonts.googleapis.com/" rel="preconnect" />
  <link href="https://fonts.gstatic.com/" rel="preconnect" crossorigin="anonymous" />
  <!--[if lt IE 9]><script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.min.js" type="text/javascript"></script><![endif]-->
  <script type="text/javascript">
    !(function (o, c) {
      var n = c.documentElement,
        t = " w-mod-";
      (n.className += t + "js"), ("ontouchstart" in o || (o.DocumentTouch && c instanceof DocumentTouch)) && (n.className += t + "touch");
    })(window, document);
  </script>
  <link href={getAssetPath('/assets/favicon.png')} rel="shortcut icon" type="image/x-icon" />
  <link href={getAssetPath('/assets/favicon.png')} rel="apple-touch-icon" />
  
  <!-- Google tag (gtag.js) -->
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
  <script is:inline define:vars={{ isDevelopment, isProduction, GA4_MEASUREMENT_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    // Environment-based configuration
    const gaConfig = {
      debug_mode: isDevelopment, // Enable debug mode only in development
      send_page_view: true,
    };

    if (isProduction) {
      gtag('config', GA4_MEASUREMENT_ID, gaConfig);
      console.log('GA4 initialized for production with ID:', GA4_MEASUREMENT_ID);
    }
  
    // Development logging
    if (isDevelopment) {
      console.log('Development Environment Detected');
      console.log('GA4 Status: Disabled in development (to avoid localhost errors)');
      console.log('GA4 will be active when deployed to production');
      
      // Mock analytics for development testing
      window.gtag = window.gtag || function() {
        console.log('Mock GA4 Event:', arguments);
      };
    }
  </script>
</head>
